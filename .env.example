# Copy this file to ".env" and fill in your real values.
# The ".env" file is private — never commit it (it is already in .gitignore).

# Neon PostgreSQL database
LC_DB_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DB?sslmode=require
LC_DB_USER=YOUR_USER
LC_DB_PASSWORD=YOUR_PASSWORD

# Long random secret used to sign login tokens (the JWT secret).
# Generate one with:  openssl rand -base64 64
LC_JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTES_BASE64

# Optional overrides
# LC_PORT=8080
# LC_ACCESS_EXPIRY_MINUTES=15
# LC_REFRESH_EXPIRY_DAYS=7
# LC_CORS_ORIGINS=http://localhost:5173,https://localui.abdulmajid.in

# Email ("verify your email" and "reset password" links).
#
# Create a Google App Password first (https://myaccount.google.com/apppasswords,
# needs 2-Step Verification ON). The 16 characters are shown with spaces
# (e.g. "abcd efgh ijkl mnop") — you can paste them with or without spaces.
# LC_MAIL_USERNAME=you@gmail.com     # full Gmail address (SMTP login)
# LC_MAIL_PASSWORD=abcd efgh ijkl mnop
# LC_MAIL_HOST=smtp.gmail.com
# LC_MAIL_PORT=587
# LC_MAIL_FROM=you@gmail.com

# Emailed links point at the request's own host by default (localhost:5173 in
# dev, your-tunnel.host when deployed). Set this to pin a fixed base URL:
# LC_APP_BASE_URL=https://app.example.com